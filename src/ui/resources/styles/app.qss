/* ===========================================================================
 * 实验报告记录工具 - 全局样式表
 *
 * 本文件定义应用程序的全局 UI 样式，包括：
 * - 基础控件样式（按钮、输入框、下拉框等）
 * - 对话框样式
 * - 列表/表格样式
 * - 工具栏/状态栏样式
 *
 * 主题颜色通过 AppConfig 读取，运行时可动态替换。
 * =========================================================================== */

/* ===========================================================================
 * 全局基础
 * =========================================================================== */

QWidget {
    color: #303133;
}

QDialog {
    background-color: #FFFFFF;
}

/* ===========================================================================
 * 按钮
 * =========================================================================== */

QPushButton {
    background-color: #4A90D9;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #357ABD;
}

QPushButton:pressed {
    background-color: #2D6AA3;
}

QPushButton:disabled {
    background-color: #A0CFFF;
    color: #FFFFFF;
}

/* 次要按钮（取消、关闭等） */
QPushButton[variant="secondary"] {
    background-color: #FFFFFF;
    color: #606266;
    border: 1px solid #DCDFE6;
}

QPushButton[variant="secondary"]:hover {
    background-color: #ECF5FF;
    color: #4A90D9;
    border-color: #4A90D9;
}

/* 危险按钮（删除等） */
QPushButton[variant="danger"] {
    background-color: #F56C6C;
}

QPushButton[variant="danger"]:hover {
    background-color: #E25555;
}

/* 成功按钮 */
QPushButton[variant="success"] {
    background-color: #67C23A;
}

QPushButton[variant="success"]:hover {
    background-color: #5DAE34;
}

/* ===========================================================================
 * 输入框
 * =========================================================================== */

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #DCDFE6;
    border-radius: 4px;
    padding: 5px 8px;
    selection-background-color: #4A90D9;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #4A90D9;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #F5F7FA;
    color: #909399;
}

/* ===========================================================================
 * 下拉框
 * =========================================================================== */

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #DCDFE6;
    border-radius: 4px;
    padding: 5px 8px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #C0C4CC;
}

QComboBox:focus {
    border-color: #4A90D9;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #909399;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #DCDFE6;
    border-radius: 4px;
    selection-background-color: #ECF5FF;
    selection-color: #4A90D9;
    outline: none;
}

/* ===========================================================================
 * 复选框 / 单选框
 * =========================================================================== */

QCheckBox, QRadioButton {
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator {
    border: 1px solid #DCDFE6;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #4A90D9;
    border-color: #4A90D9;
    image: none;
}

QRadioButton::indicator {
    border: 1px solid #DCDFE6;
    border-radius: 9px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:checked {
    background-color: #4A90D9;
    border-color: #4A90D9;
}

/* ===========================================================================
 * 数值输入框
 * =========================================================================== */

QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #DCDFE6;
    border-radius: 4px;
    padding: 5px 8px;
    min-height: 20px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #4A90D9;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 20px;
    border: none;
    background-color: transparent;
}

/* ===========================================================================
 * 列表 / 表格
 * =========================================================================== */

QListWidget, QTreeWidget, QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E4E7ED;
    border-radius: 4px;
    outline: none;
}

QListWidget::item, QTreeWidget::item, QTableWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #F2F6FC;
    text-align: center;   /* 表格内容水平居中 */
}

QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected {
    background-color: #ECF5FF;
    color: #4A90D9;
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #F5F7FA;
}

QHeaderView::section {
    background-color: #F5F7FA;
    color: #606266;
    border: none;
    border-bottom: 1px solid #E4E7ED;
    padding: 8px;
    font-weight: bold;
    text-align: center;   /* 表头水平居中 */
}

/* ===========================================================================
 * 标签页
 * =========================================================================== */

QTabWidget::pane {
    border: 1px solid #E4E7ED;
    border-radius: 4px;
    top: -1px;
}

QTabBar::tab {
    background-color: #F5F7FA;
    border: 1px solid #E4E7ED;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 8px 16px;
    margin-right: 2px;
    color: #606266;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #4A90D9;
    border-bottom: 2px solid #4A90D9;
}

QTabBar::tab:hover:!selected {
    color: #4A90D9;
}

/* ===========================================================================
 * 分组框
 * =========================================================================== */

QGroupBox {
    border: 1px solid #E4E7ED;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: bold;
    color: #303133;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    background-color: #FFFFFF;
}

/* ===========================================================================
 * 滚动条
 * =========================================================================== */

QScrollBar:vertical {
    background-color: #F5F7FA;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #C0C4CC;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #909399;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #F5F7FA;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #C0C4CC;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #909399;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ===========================================================================
 * 工具栏 / 状态栏
 * =========================================================================== */

QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E4E7ED;
    spacing: 4px;
    padding: 4px 8px;
}

QToolBar QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    color: #606266;
}

QToolBar QToolButton:hover {
    background-color: #ECF5FF;
    color: #4A90D9;
}

QToolBar QToolButton:checked {
    background-color: #D9ECFF;
    color: #1E6BB8;
    border: 1px solid #A8C8E8;
}

QToolBar QToolButton:pressed {
    background-color: #C6E0F7;
    color: #1E6BB8;
}

QStatusBar {
    background-color: #F5F7FA;
    border-top: 1px solid #E4E7ED;
    color: #606266;
}

QStatusBar QLabel {
    padding: 0 8px;
}

/* ===========================================================================
 * 菜单
 * =========================================================================== */

QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E4E7ED;
}

QMenuBar::item {
    padding: 6px 12px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #ECF5FF;
    color: #4A90D9;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E4E7ED;
    border-radius: 4px;
    padding: 4px 0;
}

QMenu::item {
    padding: 6px 24px 6px 16px;
}

QMenu::item:selected {
    background-color: #ECF5FF;
    color: #4A90D9;
}

QMenu::separator {
    height: 1px;
    background-color: #EBEEF5;
    margin: 4px 8px;
}

/* ===========================================================================
 * 进度条
 * =========================================================================== */

QProgressBar {
    background-color: #F5F7FA;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #4A90D9;
    border-radius: 4px;
}

/* ===========================================================================
 * 工具提示
 * =========================================================================== */

QToolTip {
    background-color: #303133;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
}
